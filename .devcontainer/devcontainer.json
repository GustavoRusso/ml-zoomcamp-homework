{
  "name": "ML Zoomcamp",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "uv sync",
  "forwardPorts": [8888],
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
